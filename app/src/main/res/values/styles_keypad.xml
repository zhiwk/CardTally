<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Amount keypad keys.

      The keys are declared as plain `TextView`s in the layout on purpose: the
      theme replaces framework `Button`s with Material3 buttons, whose inherited
      background tint plus `android:background=@empty` parent style produced solid
      primary blocks that hid every label (round-6 FAIL-16). A TextView inherits no
      tint, so the background and foreground declared here are exactly what is
      rendered.

      Colours use surface / on-surface tokens so the keys stay readable now and
      follow a dark palette if one is added later.
    -->
    <style name="Widget.CardTally.KeypadButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/bg_keypad_key</item>
    </style>

    <style name="Widget.CardTally.KeypadButtonPrimary" parent="Widget.CardTally.KeypadButton">
        <item name="android:textColor">@color/onPrimary_light</item>
        <item name="android:background">@drawable/bg_keypad_key_primary</item>
    </style>
</resources>
