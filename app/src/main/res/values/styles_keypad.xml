<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.CardTally.KeypadButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/bg_summary_item</item>
    </style>

    <style name="Widget.CardTally.KeypadButtonPrimary" parent="Widget.CardTally.KeypadButton">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:background">@drawable/shape_button_primary</item>
    </style>
</resources>
