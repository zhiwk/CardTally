<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_light"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/button_range_cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dialog_cancel" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_date_range_title" android:textColor="?attr/colorOnSurface" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/button_range_done" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/dialog_done" android:textColor="?attr/colorOnSurface" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/chip_range_all" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="@string/search_range_all" android:textSize="12sp" />
        <Button android:id="@+id/chip_range_this_month" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/search_range_this_month" android:textSize="12sp" />
        <Button android:id="@+id/chip_range_last_month" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/search_range_last_month" android:textSize="12sp" />
        <Button android:id="@+id/chip_range_this_week" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/search_range_this_week" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/chip_range_three_months" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="@string/search_range_three_months" android:textSize="12sp" />
        <Button android:id="@+id/chip_range_six_months" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/search_range_six_months" android:textSize="12sp" />
        <Button android:id="@+id/chip_range_this_year" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="@string/search_range_this_year" android:textSize="12sp" />
        <Button android:id="@+id/chip_range_last_year" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/search_range_last_year" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/button_range_start" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="@string/search_start_date" android:textSize="12sp" />
        <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center" android:text="至" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
        <Button android:id="@+id/button_range_end" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="@string/search_end_date" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
