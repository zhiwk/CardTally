<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin_small"
    style="@style/CardMedium">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding_medium">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收支趋势"
            android:textSize="@dimen/text_size_body1"
            android:textStyle="bold"
            android:textColor="@color/onBackground_light"
            android:textAppearance="@style/TextAppearance.CardTally.Subtitle1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/chart_placeholder"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@color/neutral_100"
            android:layout_marginTop="@dimen/spacing_m"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_title"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/text_chart_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="图表功能开发中..."
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/onSurfaceVariant_light"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/chart_placeholder"
            app:layout_constraintBottom_toBottomOf="@+id/chart_placeholder" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
