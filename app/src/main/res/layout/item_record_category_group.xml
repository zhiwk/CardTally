<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/record_category_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@android:color/transparent"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/cardSurfaceColor"
    app:cardCornerRadius="@dimen/card_corner_radius_medium"
    app:cardElevation="0dp"
    app:cardForegroundColor="@android:color/transparent"
    app:strokeColor="@color/outlineVariant_light"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/record_category_group_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <FrameLayout
                android:id="@+id/record_category_group_icon_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_primary_container"
                android:backgroundTint="@color/surface_container_low">

                <ImageView
                    android:id="@+id/image_parent_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_category_other"
                    app:tint="@color/onSurfaceVariant_light" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_parent_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/onSurface_light"
                android:textSize="16sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/text_selected_child"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxEms="6"
                android:maxLines="1"
                android:textColor="@color/onPrimaryContainer_light"
                android:textSize="14sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/image_expand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/category_expand_content_description"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/onSurfaceVariant_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/children_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
