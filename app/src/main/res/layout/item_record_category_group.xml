<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/record_category_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/primaryContainer_light"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_container_highest"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/record_category_group_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <FrameLayout
                android:id="@+id/record_category_group_icon_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_primary_container"
                android:backgroundTint="@color/surface_light">

                <ImageView
                    android:id="@+id/image_parent_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_category_other"
                    app:tint="@color/onPrimaryContainer_light" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_parent_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/onPrimaryContainer_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/image_expand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/category_expand_content_description"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/onPrimaryContainer_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/children_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_container_lowest"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
