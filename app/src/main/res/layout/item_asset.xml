<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:paddingBottom="0dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_light"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:minHeight="48dp"
            android:paddingVertical="8dp">

            <FrameLayout
                android:id="@+id/icon_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_primary_container"
                android:backgroundTint="#FFFFFF">
                
                <ImageView
                    android:id="@+id/image_asset_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_asset"
                    app:tint="?attr/colorPrimary"/>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_asset_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_asset_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/text_asset_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <ImageView
                android:id="@+id/icon_asset_pinned"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="置顶资产"
                android:src="@drawable/ic_push_pin"
                android:visibility="gone"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/text_asset_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥ 84,200.00"
                android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
