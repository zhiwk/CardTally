<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@color/warning_container"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/btn_archive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="归档"
                android:padding="18dp"
                android:src="@drawable/ic_archive"
                app:tint="@color/warning_primary" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@color/success_container"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/btn_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="编辑"
                android:padding="18dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/success_primary" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="68dp"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/error_container"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="删除"
                android:padding="18dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/error_primary" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_light"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/selector_button_primary" />

            <LinearLayout
                android:id="@+id/layout_asset_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_asset_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="现金"
                    android:textColor="@color/onBackground_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_asset_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="现金"
                    android:textColor="@color/editorial_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_asset_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥1000.00"
                android:textColor="@color/onBackground_light"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
