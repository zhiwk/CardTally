<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light"
    tools:context=".AddRecordFragment">

    <!-- Top Navigation -->
    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:background="#D9fffcf7">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/onSurfaceVariant_light" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/record_title_new"
            android:textColor="@color/primary_light"
            android:textSize="20sp"
            android:textStyle="italic" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:clipToPadding="false"
        android:paddingBottom="140dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="16dp">

            <!-- Hero Section: Amount Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_amount_label"
                    android:textColor="@color/editorial_text_muted"
                    android:textSize="10sp"
                    android:alpha="0.6"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥"
                        android:textColor="@color/primary_light"
                        android:textSize="36sp"
                        android:textStyle="normal"
                        android:fontFamily="serif"/>
                        
                    <EditText
                        android:id="@+id/edit_amount"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@null"
                        android:text="@string/amount_default"
                        android:textColor="@color/onBackground_light"
                        android:textSize="72sp"
                        android:inputType="numberDecimal"
                        android:fontFamily="serif"
                        android:textStyle="normal"
                        android:layout_marginStart="8dp"
                        android:importantForAutofill="no"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Subtly Styled Toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_summary_item"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp"
                android:padding="4dp">
                
                <Button
                    android:id="@+id/btn_expense"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/shape_button_primary"
                    android:text="@string/record_type_expense"
                    android:textColor="@color/onPrimary_light"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:paddingHorizontal="32dp"
                    android:minWidth="0dp"/>
                    
                <Button
                    android:id="@+id/btn_income"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:text="@string/record_type_income"
                    android:textColor="@color/onSurfaceVariant_light"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:paddingHorizontal="32dp"
                    android:minWidth="0dp"/>
            </LinearLayout>

            <!-- Minimalist Ledger Inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="48dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_when_label"
                        android:textColor="@color/primaryVariant_light"
                        android:textSize="20sp"
                        android:textStyle="italic"
                        android:fontFamily="serif"/>
                        
                    <TextView
                        android:id="@+id/text_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/record_date_placeholder"
                        android:textSize="18sp"
                        android:textColor="@color/onBackground_light"
                        android:background="@null"
                        android:paddingVertical="8dp"/>
                        
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#4Dbabab0"/> <!-- outline-variant at 30% -->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_asset_label"
                        android:textColor="@color/primaryVariant_light"
                        android:textSize="20sp"
                        android:textStyle="italic"
                        android:fontFamily="serif"/>

                    <Spinner
                        android:id="@+id/spinner_asset_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:background="@null" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#4Dbabab0"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/record_detail_label"
                        android:textColor="@color/primaryVariant_light"
                        android:textSize="20sp"
                        android:textStyle="italic"
                        android:fontFamily="serif"/>
                        
                    <EditText
                        android:id="@+id/edit_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/record_detail_hint"
                        android:textSize="18sp"
                        android:textColor="@color/onBackground_light"
                        android:textColorHint="@color/placeholder_light"
                        android:background="@null"
                        android:paddingVertical="8dp"
                        android:maxLines="1"
                        android:inputType="text"/>
                        
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#4Dbabab0"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Category Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_category_label"
                    android:textColor="@color/editorial_text_muted"
                    android:textSize="10sp"
                    android:alpha="0.6"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>
                    
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
            
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BottomNavBar (The Footer Shell) -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_sheet"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal"
        android:elevation="16dp">

        <LinearLayout
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close"
                app:tint="@color/onSurfaceVariant_light"
                android:alpha="0.6"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/record_cancel"
                android:textSize="10sp"
                android:textColor="@color/onSurfaceVariant_light"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:alpha="0.6"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/shape_button_primary"
            android:padding="12dp">
            
            <ImageView
                android:id="@+id/image_save_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check"
                app:tint="@color/onPrimary_light" />
                
            <TextView
                android:id="@+id/text_save_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/record_save_entry"
                android:textSize="10sp"
                android:textColor="@color/onPrimary_light"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
