<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
    android:background="?attr/selectableItemBackground" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingHorizontal="12dp" android:paddingVertical="10dp"
    android:clickable="true" android:focusable="true">
    <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
        <ImageView android:id="@+id/option_icon" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/option_label" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp" android:textSize="16sp"
        android:textColor="?attr/colorOnSurface" />
    <ImageView android:layout_width="20dp" android:layout_height="20dp"
        android:importantForAccessibility="no" android:src="@drawable/tabler_chevron_right"
        android:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
