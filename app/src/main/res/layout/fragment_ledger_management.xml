<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/pageBackgroundColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
        <ImageButton android:id="@+id/button_ledger_management_back" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/content_description_back"
            android:padding="8dp" android:src="@drawable/ic_arrow_back" android:tint="?attr/colorOnSurface" />
        <TextView android:id="@+id/ledger_management_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ledger_management_title" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/button_ledger_management_add" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ledger_management_add"
            android:padding="8dp" android:src="@drawable/ic_add" android:tint="?attr/colorOnSurface" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="16dp" android:paddingBottom="32dp">
            <LinearLayout android:id="@+id/ledger_management_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:id="@+id/ledger_management_asset_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/ledger_management_selection_actions" android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:visibility="gone" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
        <Button android:id="@+id/button_ledger_management_delete_selected" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="@string/ledger_management_delete_action" android:textColor="?attr/colorOnError" android:backgroundTint="@color/error" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <Button android:id="@+id/button_ledger_management_merge_selected" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:text="@string/ledger_management_merge_action" android:textColor="?attr/colorOnPrimary" android:backgroundTint="?attr/colorPrimary" />
    </LinearLayout>
    <TextView android:id="@+id/ledger_management_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:padding="12dp" android:text="@string/ledger_management_hint" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
</LinearLayout>
