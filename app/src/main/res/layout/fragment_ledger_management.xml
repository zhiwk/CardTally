<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/pageBackgroundColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
        <ImageButton android:id="@+id/button_ledger_management_back" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/content_description_back"
            android:padding="8dp" android:src="@drawable/ic_arrow_back" android:tint="?attr/colorOnSurface" />
        <TextView android:id="@+id/ledger_management_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ledger_management_title" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/button_ledger_management_add" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ledger_management_add"
            android:padding="8dp" android:src="@drawable/ic_add" android:tint="?attr/colorOnSurface" />
        <TextView android:id="@+id/button_ledger_management_manage" android:layout_width="wrap_content" android:layout_height="48dp"
            android:minWidth="48dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:background="?attr/selectableItemBackground" android:text="@string/ledger_ui_manage"
            android:clickable="true" android:focusable="true"
            android:textSize="16sp" android:textColor="?attr/colorOnSurface" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ledger_management_selection_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone">
        <TextView android:id="@+id/ledger_management_selection_count" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/ledger_management_selection_reason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="16dp" android:paddingBottom="32dp">
            <LinearLayout android:id="@+id/ledger_management_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:id="@+id/ledger_management_asset_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/ledger_management_selection_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/colorSurface" android:orientation="horizontal" android:visibility="gone" android:paddingTop="8dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/button_ledger_management_delete_selected" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_weight="1" android:text="@string/ledger_management_delete_action" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_ledger_management_merge_selected" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_weight="1" android:text="@string/ledger_management_merge_action" />
    </LinearLayout>
    <TextView android:id="@+id/ledger_management_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:padding="12dp" android:text="@string/ledger_management_hint" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
</LinearLayout>
