<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ai_record_action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">
    <TextView
        android:id="@+id/text_ai_record_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:accessibilityLiveRegion="polite" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_ai_record_review"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/ai_record_review"
            android:textColor="@color/onPrimary_light"
            app:backgroundTint="@color/buttonPrimary_light"
            app:cornerRadius="12dp"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_ai_record_reject"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ai_record_reject"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
