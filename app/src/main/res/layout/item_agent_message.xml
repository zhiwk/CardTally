<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_agent_message_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_agent_message_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/agent_role_assistant"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layout_agent_reasoning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_agent_surface"
        android:maxWidth="320dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/row_agent_reasoning_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_agent_reasoning_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/tabler_chevron_down"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/text_agent_reasoning_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/agent_reasoning_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_agent_reasoning_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_agent_message_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_agent_bubble_assistant"
        android:elevation="0dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4dp"
        android:maxWidth="320dp"
        android:outlineProvider="background"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

</LinearLayout>
