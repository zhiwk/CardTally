<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ledger_content" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/pageBackgroundColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/ledger_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="0dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/button_ledger_switch" android:layout_width="32dp" android:layout_height="32dp" android:minWidth="0dp" android:minHeight="0dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ledger_book_switch_content_description" android:padding="6dp" android:src="@drawable/ic_book" app:tint="?attr/colorOnSurface" />
        <TextView android:id="@+id/text_month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="日常账本" android:textColor="?attr/colorOnSurface" android:textSize="20sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/button_ledger_search" android:layout_width="32dp" android:layout_height="32dp" android:minWidth="0dp" android:minHeight="0dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/content_description_search" android:padding="6dp" android:src="@drawable/ic_search" app:tint="?attr/colorOnSurface" />
        <ImageButton android:id="@+id/button_ledger_calendar" android:layout_width="32dp" android:layout_height="32dp" android:minWidth="0dp" android:minHeight="0dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/ledger_calendar_content_description" android:padding="6dp" android:src="@drawable/ic_calendar" app:tint="?attr/colorOnSurface" />
    </LinearLayout>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager_months" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layoutDirection="ltr" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_scroll_top" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="bottom|end" android:layout_marginEnd="28dp" android:layout_marginBottom="@dimen/floating_scroll_top_fab_bottom_margin" android:contentDescription="@string/content_description_scroll_top" android:elevation="12dp" android:src="@drawable/ic_arrow_up" android:visibility="gone" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CardTally.FabCircle" app:backgroundTint="?attr/colorPrimary" app:tint="?attr/colorOnPrimary" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_add" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="bottom|end" android:layout_marginEnd="@dimen/floating_primary_fab_end_margin" android:layout_marginBottom="@dimen/floating_primary_fab_gap_above_nav" android:contentDescription="@string/content_description_add" android:src="@drawable/ic_add" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CardTally.FabCircle" app:backgroundTint="?attr/colorPrimary" app:elevation="@dimen/card_elevation_none" app:hoveredFocusedTranslationZ="@dimen/card_elevation_none" app:pressedTranslationZ="@dimen/card_elevation_none" app:tint="?attr/colorOnPrimary" />
</FrameLayout>
