<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackgroundColor"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="12dp">
        <ImageButton android:id="@+id/button_ledger_setup_back"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_back"
            android:padding="12dp" android:src="@drawable/ic_arrow_back" app:tint="?attr/colorOnSurface" />
        <TextView android:id="@+id/ledger_setup_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ledger_setup_title" android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <ScrollView android:id="@+id/ledger_setup_scroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="4dp" android:paddingBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface" android:gravity="center_vertical"
                android:baselineAligned="false" android:padding="16dp">
                <LinearLayout android:id="@+id/ledger_setup_icon_picker"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="64dp" android:minHeight="64dp" android:gravity="center"
                    android:orientation="vertical" android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView android:id="@+id/ledger_setup_icon"
                        android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
                        android:background="@drawable/bg_circle_primary_container"
                        android:contentDescription="@null" app:tint="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:maxWidth="80dp" android:gravity="center"
                        android:layout_marginTop="4dp" android:text="@string/ledger_setup_change_icon"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:labelFor="@id/ledger_setup_name" android:text="@string/ledger_setup_name_label"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    <EditText android:id="@+id/ledger_setup_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:hint="@string/ledger_setup_name_hint"
                        android:importantForAutofill="no" android:inputType="textCapSentences"
                        android:imeOptions="actionDone" android:singleLine="true" android:saveEnabled="false"
                        android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/ledger_setup_asset_relation_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/bg_card_surface"
                android:orientation="vertical" android:paddingTop="16dp" android:paddingBottom="8dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:text="@string/ledger_asset_card_title" android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/ledger_setup_asset_mode_group"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/ledger_setup_existing_row"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="64dp" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/ledger_asset_existing_group" android:textSize="16sp" android:textColor="?attr/colorOnSurface" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="@string/ledger_asset_existing_group_hint"
                                android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <RadioButton android:id="@+id/ledger_setup_share_other_assets"
                            android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="12dp"
                            android:clickable="false" android:focusable="false" android:saveEnabled="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/ledger_setup_asset_list"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <LinearLayout android:id="@+id/ledger_setup_group_row"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:minHeight="64dp" android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                            android:paddingStart="28dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="12dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/ledger_setup_choose_ledger"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:text="@string/ledger_setup_shared_group_label" android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/ledger_setup_group_name"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2"
                                    android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
                                <TextView android:id="@+id/ledger_setup_group_summary"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2"
                                    android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
                            </LinearLayout>
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginStart="12dp" android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/ledger_setup_independent_row"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="64dp" android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/ledger_asset_new_group" android:textSize="16sp" android:textColor="?attr/colorOnSurface" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="@string/ledger_asset_new_group_hint"
                                android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <RadioButton android:id="@+id/ledger_setup_independent_assets"
                            android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="12dp"
                            android:clickable="false" android:focusable="false" android:saveEnabled="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </RadioGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:text="@string/ledger_setup_shared_note" android:textSize="14sp" android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView android:id="@+id/ledger_setup_create_note"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp" android:gravity="center"
        android:text="@string/ledger_setup_create_note" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="14sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_ledger_setup_save"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"
        android:minHeight="52dp" android:text="@string/ledger_setup_save" android:textAllCaps="false"
        android:textColor="@color/onPrimary_light" app:backgroundTint="@color/buttonPrimary_light"
        app:cornerRadius="12dp" app:elevation="0dp" />
</LinearLayout>
