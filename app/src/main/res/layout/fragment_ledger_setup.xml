<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackgroundColor"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/button_ledger_setup_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/ledger_setup_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ledger_setup_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/ledger_setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Basic information: Header avatar icon + Ledger Name input in one card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                 android:paddingStart="12dp"
                 android:paddingTop="8dp"
                 android:paddingEnd="12dp"
                 android:paddingBottom="8dp">

                <!-- Avatar Icon Picker Trigger -->
                <FrameLayout
                    android:id="@+id/ledger_setup_icon_picker"
                     android:layout_width="48dp"
                     android:layout_height="48dp"
                    android:background="@drawable/bg_circle_primary_container"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/ledger_setup_icon"
                         android:layout_width="20dp"
                         android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurface" />

                    <!-- Small edit indicator badge -->
                     <ImageView
                          android:layout_width="14dp"
                         android:layout_height="14dp"
                         android:layout_gravity="bottom|end"
                         android:contentDescription="@null"
                         android:src="@drawable/ic_edit"
                         app:tint="?attr/colorOnSurfaceVariant" />
                </FrameLayout>

                 <!-- Ledger Name Field Area -->
                 <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                     android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                     <EditText
                        android:id="@+id/ledger_setup_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                         android:background="@android:color/transparent"
                         android:hint="@string/ledger_setup_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                         android:minHeight="40dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                         android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Asset relationship: Choice Card Section -->
            <LinearLayout
                android:id="@+id/ledger_setup_asset_relation_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/ledger_asset_card_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/ledger_setup_asset_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Choice A: Independent Assets -->
                    <LinearLayout
                        android:id="@+id/ledger_setup_independent_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <RadioButton
                            android:id="@+id/ledger_setup_independent_assets"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ledger_asset_new_group"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ledger_asset_new_group_hint"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/editorial_outline" />

                    <!-- Choice B: Shared Assets -->
                    <LinearLayout
                        android:id="@+id/ledger_setup_existing_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <RadioButton
                            android:id="@+id/ledger_setup_share_other_assets"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ledger_asset_existing_group"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/ledger_asset_existing_group_hint"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Group Picker Row -->
                    <LinearLayout
                        android:id="@+id/ledger_setup_asset_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_ledger_asset_child"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:visibility="gone">

                        <View
                            android:id="@+id/ledger_setup_group_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="@color/outlineVariant_light" />

                        <LinearLayout
                            android:id="@+id/ledger_setup_group_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="64dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/ledger_setup_choose_ledger"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ledger_asset_group_picker_title"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/ledger_setup_group_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/ledger_setup_group_summary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Save Action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_ledger_setup_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="52dp"
        android:text="@string/ledger_setup_save"
        android:textAllCaps="false"
        android:textColor="@color/onPrimary_light"
        app:backgroundTint="@color/buttonPrimary_light"
        app:cornerRadius="12dp"
        app:elevation="0dp" />
</LinearLayout>
