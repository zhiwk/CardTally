<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false"
    android:paddingBottom="112dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_recurring_edit_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/record_cancel"
                android:padding="12dp"
                android:src="@drawable/tabler_arrow_left"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/text_recurring_edit_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_recurring_delete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/recurring_delete_accessibility"
                    android:padding="12dp"
                    android:src="@drawable/tabler_trash"
                    android:visibility="gone"
                    app:tint="@color/error_primary" />

                <ImageButton
                    android:id="@+id/btn_recurring_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/recurring_save_accessibility"
                    android:padding="12dp"
                    android:src="@drawable/tabler_check"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardForegroundColor="@android:color/transparent"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="@string/recurring_period_section"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/text_recurring_start_date"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_start_date">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_start_date" />
                    <TextView android:id="@+id/value_recurring_start_date" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_frequency"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_frequency">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_frequency" />
                    <TextView android:id="@+id/value_recurring_frequency" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_end_date"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_end_date">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_end_date" />
                    <TextView android:id="@+id/value_recurring_end_date" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardForegroundColor="@android:color/transparent"
            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="@string/recurring_bill_section"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_name" />
                    <EditText
                        android:id="@+id/edit_recurring_name"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="end|center_vertical"
                        android:hint="@string/recurring_name_hint"
                        android:inputType="textCapSentences"
                        android:paddingStart="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_type"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_type">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_type" />
                    <TextView android:id="@+id/value_recurring_type" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_amount" />
                    <EditText
                        android:id="@+id/edit_recurring_amount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end|center_vertical"
                        android:hint="¥0.00"
                        android:inputType="numberDecimal"
                        android:paddingStart="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_ledger"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_ledger">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_ledger" />
                    <TextView android:id="@+id/value_recurring_ledger" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_category"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_category">
                    <TextView android:id="@+id/label_recurring_category" style="@style/RecurringRowLabel" android:text="@string/recurring_category" />
                    <TextView android:id="@+id/value_recurring_category" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_asset"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="@string/recurring_asset">
                    <TextView android:id="@+id/label_recurring_asset" style="@style/RecurringRowLabel" android:text="@string/recurring_asset" />
                    <TextView android:id="@+id/value_recurring_asset" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/text_recurring_destination_asset"
                    style="@style/RecurringSelectorRow"
                    android:contentDescription="转入账户">
                    <TextView style="@style/RecurringRowLabel" android:text="转入账户" />
                    <TextView android:id="@+id/value_recurring_destination_asset" style="@style/RecurringRowValue" />
                    <ImageView style="@style/RecurringChevron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_note" />
                    <EditText
                        android:id="@+id/edit_recurring_note"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="end|center_vertical"
                        android:hint="@string/recurring_note_hint"
                        android:inputType="textCapSentences"
                        android:paddingStart="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/RecurringRowLabel" android:text="@string/recurring_enabled" />
                    <Switch
                        android:id="@+id/switch_recurring_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
