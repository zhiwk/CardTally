<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin_small"
    style="@style/CardMedium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding_medium">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主色调色"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/onSurfaceVariant_light"
            android:layout_marginBottom="@dimen/spacing_s" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_primary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:backgroundTint="@color/primary_light"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_secondary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:backgroundTint="@color/secondary_light"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_accent"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/accent_light"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="强调色调色"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/onSurfaceVariant_light"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_s" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_success"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:backgroundTint="@color/success_primary"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_warning"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:backgroundTint="@color/warning_primary"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_error"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/error_primary"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="背景色调色"
            android:textSize="@dimen/text_size_body2"
            android:textColor="@color/onSurfaceVariant_light"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_s" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_s">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_background"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:backgroundTint="@color/background_light"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_color_surface"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:backgroundTint="@color/surface_light"
                    app:cornerRadius="@dimen/button_corner_radius_medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</androidx.cardview.widget.CardView>
