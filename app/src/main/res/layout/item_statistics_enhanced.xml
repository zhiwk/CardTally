<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin_small"
    android:layout_marginBottom="@dimen/card_spacing_small"
    style="@style/CardMedium">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_padding_medium">

        <TextView
            android:id="@+id/text_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="餐饮"
            android:textSize="@dimen/text_size_body1"
            android:textStyle="bold"
            android:textColor="@color/onBackground_light"
            android:textAppearance="@style/TextAppearance.CardTally.ListTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="35%"
            android:textSize="@dimen/text_size_h6"
            android:textStyle="bold"
            android:textColor="@color/primary_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥1,200.00"
            android:textSize="@dimen/text_size_h6"
            android:textStyle="bold"
            android:textColor="@color/expense_primary"
            android:textAppearance="@style/TextAppearance.CardTally.Amount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/text_percentage"
            app:layout_constraintTop_toBottomOf="@+id/text_category"
            app:layout_constraintBaseline_toBaselineOf="@+id/text_category" />

        <View
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@color/primary_light"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_amount"
            app:layout_constraintBottom_toTopOf="@+id/text_category"
            app:layout_constraintBaseline_toBaselineOf="@+id/text_amount" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
