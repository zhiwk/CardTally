<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/card_padding_large"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/touch_target_min">

    <ImageView
        android:id="@+id/icon_setting"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:scaleType="centerCrop"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/spacing_s"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置项标题"
            android:textSize="@dimen/text_size_body1"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:textAppearance="@style/TextAppearance.CardTally.Body1" />

        <TextView
            android:id="@+id/text_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置项描述"
            android:textSize="@dimen/text_size_caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:textAppearance="@style/TextAppearance.CardTally.Caption" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置值"
        android:textSize="@dimen/text_size_body2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginStart="@dimen/spacing_s"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/icon_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right"
        android:alpha="0.4"
        android:layout_marginStart="@dimen/spacing_s" />

</LinearLayout>
