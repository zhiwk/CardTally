<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container"
    tools:context=".StatisticsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/content_bottom_padding_with_floating_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_ledger_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/nav_statistics"
                    android:src="@drawable/ic_menu"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/nav_statistics"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="24sp"
                    android:textStyle="italic"
                    android:fontFamily="serif" />

                <LinearLayout
                    android:id="@+id/layout_mode_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_view_mode_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/editorial_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        tools:text="统计" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/editorial_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:scrollbars="none"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_period_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:selectionRequired="false"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_period_week"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/ledger_period_week"
                        android:textAllCaps="true"
                        app:backgroundTint="@color/surface_container_high"
                        app:cornerRadius="18dp"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_period_month"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/ledger_period_month"
                        android:textAllCaps="true"
                        app:backgroundTint="@color/surface_container_high"
                        app:cornerRadius="18dp"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_period_year"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/ledger_period_year"
                        android:textAllCaps="true"
                        app:backgroundTint="@color/surface_container_high"
                        app:cornerRadius="18dp"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_period_all"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/ledger_period_all"
                        android:textAllCaps="true"
                        app:backgroundTint="@color/surface_container_high"
                        app:cornerRadius="18dp"
                        app:elevation="0dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/layout_range_selector"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/text_range_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/editorial_text_muted"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:fontFamily="sans-serif-medium"
                    android:alpha="0.8"
                    android:letterSpacing="0.02"
                    tools:text="Apr 1, 2026 - Apr 30, 2026" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_statistics_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_statistics_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container_high"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <View
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-28dp"
                            android:layout_marginEnd="-18dp"
                            android:background="@drawable/bg_circle_primary_container"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:alpha="0.3" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/text_summary_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/editorial_text_muted"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:letterSpacing="0.14"
                                        tools:text="TOTAL NARRATIVE" />

                                    <TextView
                                        android:id="@+id/text_summary_amount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:textColor="?attr/colorPrimary"
                                        android:textSize="34sp"
                        android:fontFamily="sans-serif-medium"
                                        tools:text="¥4,280.00" />

                                    <TextView
                                        android:id="@+id/text_summary_supporting"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/editorial_text_muted"
                                        android:textSize="13sp"
                                        tools:text="静奢理财日记" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/text_summary_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_ledger_summary_badge"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="8dp"
                                    android:textColor="?attr/colorOnSecondaryContainer"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08"
                                    tools:text="4 SEGMENTS" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_monthly_income"
                                    android:textColor="@color/editorial_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/text_summary_income"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/income_primary"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-medium"
                                    tools:text="¥12,300.00" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_monthly_expense"
                                    android:textColor="@color/editorial_text_muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/text_summary_expense"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/expense_primary"
                                    android:textSize="18sp"
                                android:fontFamily="sans-serif-medium"
                                    tools:text="¥8,020.00" />
                            </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_statistics_section_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/ledger_statistics_section_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:fontFamily="serif" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_statistics_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/editorial_surface_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/text_chart_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ledger_chart_title"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:fontFamily="serif" />

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/toggle_chart_mode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_chart_line"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:minWidth="0dp"
                                    android:text="@string/ledger_chart_mode_line"
                                    android:textAllCaps="true"
                                    app:backgroundTint="@color/surface_container_high"
                                    app:cornerRadius="18dp"
                                    app:elevation="0dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_chart_pie"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:minWidth="0dp"
                                    android:text="@string/ledger_chart_mode_pie"
                                    android:textAllCaps="true"
                                    app:backgroundTint="@color/surface_container_high"
                                    app:cornerRadius="18dp"
                                    app:elevation="0dp" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_chart_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/editorial_text_muted"
                            android:textSize="11sp"
                            tools:text="按当前周期阅读流向与波动" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="240dp"
                            android:layout_marginTop="12dp">

                            <com.example.cardtally.view.LedgerLineChartView
                                android:id="@+id/view_statistics_line_chart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <com.example.cardtally.view.LedgerDonutChartView
                                android:id="@+id/view_statistics_chart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/layout_line_axis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/text_axis_start"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/editorial_text_muted"
                                android:textSize="9sp"
                                tools:text="Apr 1" />

                            <TextView
                                android:id="@+id/text_axis_mid"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="@color/editorial_text_muted"
                                android:textSize="9sp"
                                tools:text="Apr 8" />

                            <TextView
                                android:id="@+id/text_axis_end"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textColor="@color/editorial_text_muted"
                                android:textSize="9sp"
                                tools:text="Apr 15" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_chart_legend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_statistics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_statistics" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_statistics_insight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="2dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/editorial_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="24dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_book"
                            android:alpha="0.35"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/text_statistics_insight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textColor="@color/editorial_text_muted"
                            android:textSize="20sp"
                            android:textStyle="italic"
                            android:fontFamily="sans-serif-medium"
                            tools:text="真正的宽裕，是在清醒记录里仍能保有从容。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_records_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_records"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_record" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:textColor="@color/editorial_text_muted"
                android:textSize="15sp"
                android:visibility="gone"
                tools:text="暂无统计内容" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/floating_primary_fab_end_margin"
        android:layout_marginBottom="@dimen/floating_primary_fab_bottom_margin_with_nav"
        android:contentDescription="@string/add_record"
        android:src="@drawable/ic_edit"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="@dimen/card_elevation_none"
        app:hoveredFocusedTranslationZ="@dimen/card_elevation_none"
        app:pressedTranslationZ="@dimen/card_elevation_none"
        app:tint="?attr/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
